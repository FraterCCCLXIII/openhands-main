{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhands.dev/schemas/pm-hub/snapshot-1.json",
  "title": "Projects hub snapshot, version 1",
  "description": "What one adapter run says about one repository. CONTRACT.md explains each collection.",
  "type": "object",
  "required": ["schema", "version", "project", "generatedAt", "sources", "collections"],
  "properties": {
    "schema": { "const": "pm-hub.snapshot" },
    "version": { "const": 1 },
    "project": { "$ref": "#/$defs/project" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adapter", "at"],
        "properties": {
          "adapter": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "documents": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    },
    "collections": {
      "type": "object",
      "required": ["cards", "runs", "history", "costs", "calendar"],
      "properties": {
        "cards": { "$ref": "#/$defs/docs", "additionalProperties": { "$ref": "#/$defs/card" } },
        "runs": { "$ref": "#/$defs/docs", "additionalProperties": { "$ref": "#/$defs/run" } },
        "history": { "$ref": "#/$defs/docs", "additionalProperties": { "$ref": "#/$defs/historyDoc" } },
        "costs": { "$ref": "#/$defs/docs", "additionalProperties": { "$ref": "#/$defs/costDoc" } },
        "calendar": { "$ref": "#/$defs/docs", "additionalProperties": { "$ref": "#/$defs/month" } }
      },
      "additionalProperties": { "$ref": "#/$defs/docs" }
    }
  },
  "$defs": {
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "status": { "enum": ["backlog", "ready", "building", "verify", "blocked", "done"] },
    "project": {
      "type": "object",
      "required": ["id", "org", "repo", "adapter"],
      "properties": {
        "id": { "$ref": "#/$defs/projectId" },
        "org": { "type": "string" },
        "repo": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "adapter": { "enum": ["kosmos", "github"] }
      }
    },
    "docs": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.~-]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["project"],
        "properties": { "project": { "$ref": "#/$defs/projectId" } }
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "project", "title", "status"],
      "properties": {
        "id": { "type": "string" },
        "project": { "$ref": "#/$defs/projectId" },
        "title": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "sourceStatus": { "type": "string" },
        "track": { "type": "string" },
        "tier": { "enum": [1, 2, 3, 4] },
        "kind": { "type": "string" },
        "size": { "enum": ["S", "M", "L"] },
        "deps": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "type": "string" } },
        "labels": { "type": "array", "items": { "type": "string" } },
        "ask": { "type": "string" },
        "gate": { "type": "string" },
        "plan": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "run": {
      "type": "object",
      "required": ["project", "card", "status"],
      "properties": {
        "project": { "$ref": "#/$defs/projectId" },
        "card": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "claimed": { "type": ["string", "null"] },
        "landed": { "type": ["string", "null"] },
        "claimToLandH": { "type": ["number", "null"] },
        "pr": { "type": ["integer", "string", "null"] }
      }
    },
    "historyItem": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "$ref": "#/$defs/status" } }
    },
    "historyDoc": {
      "type": "object",
      "required": ["project", "kind", "items"],
      "properties": {
        "project": { "$ref": "#/$defs/projectId" },
        "kind": { "enum": ["prs", "issues", "days"] },
        "items": { "type": "array" }
      },
      "if": { "properties": { "kind": { "enum": ["prs", "issues"] } } },
      "then": { "properties": { "items": { "items": { "$ref": "#/$defs/historyItem" } } } }
    },
    "costDoc": {
      "type": "object",
      "required": ["project"],
      "properties": {
        "project": { "$ref": "#/$defs/projectId" },
        "total": { "type": "number", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/status" },
        "byStatus": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/status" },
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "month": {
      "type": "object",
      "required": ["project", "month", "days"],
      "properties": {
        "project": { "$ref": "#/$defs/projectId" },
        "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["d"],
            "properties": {
              "d": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["ref", "status"],
                  "properties": { "ref": { "type": "string" }, "status": { "$ref": "#/$defs/status" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
