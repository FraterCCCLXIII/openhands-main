{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run python:export-requirements && npm run db:migrate && npm run build",
  "crons": [
    {
      "path": "/api/cron/expire-grants",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path((?!auth).*)",
      "destination": "/api/index.py"
    }
  ]
}
