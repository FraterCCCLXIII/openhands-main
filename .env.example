# GitHub OAuth
# Create OAuth App at: https://github.com/organizations/OpenHands/settings/applications
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NextAuth / Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# Local development only - not needed on Vercel
NEXTAUTH_URL=http://localhost:3000
# DISABLE_AUTH=true limits the app to localhost requests and enables a default
# context-layer API key of `local-dev-context-key` unless you override it below.
# DISABLE_AUTH=true

# Agent authentication for POST /api/context/*
# Set one key or a comma-separated list for rotation.
CONTEXT_LAYER_API_KEY=
# CONTEXT_LAYER_API_KEYS=primary-key,backup-key

# Vercel deployments: enable OAuth on preview deployments
# Set this to your stable production URL (same value for all environments)
# AUTH_REDIRECT_PROXY_URL=https://openhands-context-layer.vercel.app/api/auth

# Vercel deployments: trust the host header
# AUTH_TRUST_HOST=true

POSTGRES_URL=
DATABASE_URL=
COMPOSIO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CRON_SECRET=change-me
