# OpenHands Cloud used for dashboard device-flow login and token validation
INTHUB_OPENHANDS_BASE_URL=https://staging.all-hands.dev

# Stored provider credential encryption
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=change-me

# INTHUB_DISABLE_AUTH=true limits the app to localhost requests. The dashboard will
# provision a personal integrations-hub API key for the current user automatically.
# INTHUB_DISABLE_AUTH=true

# Provider OAuth apps for built-in per-user connections
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=

# Provider OAuth preview deployments: set to the stable public origin
# used by third-party provider callback allowlists.
# INTHUB_OAUTH_REDIRECT_PROXY_URL=https://openhands-integrations-hub.vercel.app

# Database connection
# For production/Vercel: use Neon connection string
# For local development: use standard Postgres connection string with USE_STANDARD_PG=true
POSTGRES_URL=
DATABASE_URL=
# Set to "true" to use standard pg driver instead of Neon serverless (for local Docker Postgres)
# USE_STANDARD_PG=true
COMPOSIO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CRON_SECRET=change-me
