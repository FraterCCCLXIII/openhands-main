# GitHub OAuth
# Create OAuth App at: https://github.com/organizations/OpenHands/settings/applications
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NextAuth / Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# Local development only - not needed on Vercel
NEXTAUTH_URL=http://localhost:3000
# DISABLE_AUTH=true limits the app to localhost requests. The dashboard will
# provision a personal context-layer API key for the current user automatically.
# DISABLE_AUTH=true

# Vercel deployments: enable OAuth on preview deployments
# Set this to your stable production URL (same value for all environments)
# AUTH_REDIRECT_PROXY_URL=https://openhands-context-layer.vercel.app/api/auth

# Vercel deployments: trust the host header
# AUTH_TRUST_HOST=true

POSTGRES_URL=
DATABASE_URL=
COMPOSIO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CRON_SECRET=change-me
