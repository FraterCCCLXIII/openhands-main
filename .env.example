# OpenHands Cloud used for dashboard device-flow login and token validation
INTHUB_OPENHANDS_BASE_URL=https://staging.all-hands.dev

# Product analytics (disabled when unset)
# INTHUB_POSTHOG_CLIENT_KEY=phc_...

# Stored provider credential encryption
# Generate with: openssl rand -base64 32
INTHUB_CREDENTIAL_ENCRYPTION_KEY=change-me

# Provider OAuth apps for built-in per-user connections
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=

# Provider OAuth preview deployments: set to the stable public origin
# used by third-party provider callback allowlists.
# INTHUB_OAUTH_REDIRECT_PROXY_URL=https://openhands-integrations-hub.vercel.app

# Database connection (the backend reads only the INTHUB_-prefixed URL).
# For production/Vercel: use the Neon connection string.
# For local development: use a standard Postgres connection string.
INTHUB_POSTGRES_URL=
COMPOSIO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
INTHUB_CRON_SECRET=change-me
INTHUB_APP_ADMIN_EMAILS=

# FastAPI backend config uses explicit INTHUB_* names. Set these in Vercel for
# the Python API runtime. Leave commented out (or fully unset) unless you have
# a real value: blank `INTHUB_*=` entries are treated as "not configured" by
# the backend (see backend/app/config.py).
