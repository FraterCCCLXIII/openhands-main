{
  "name": "agent-integrations-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:spa": "./scripts/build-spa.sh",
    "start": "next start",
    "db:migrate": "./scripts/run-migrations.sh",
    "db:migrate:check": "./scripts/run-migrations.sh --check",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/lib/db/e2e-repository.test.ts --exclude src/lib/e2e-integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "coverage:branches": "node ./scripts/report-branch-gaps.mjs",
    "test:coverage:report": "npm run test:coverage && npm run coverage:branches",
    "test:e2e": "vitest run src/lib/db/e2e-repository.test.ts src/lib/e2e-integration.test.ts",
    "test:watch": "vitest",
    "test:mutation": "node ./scripts/run-mutation.mjs",
    "test:mutation:dry": "node ./scripts/run-mutation.mjs --dry-run",
    "test:mutation:all": "node ./scripts/run-mutation.mjs --all --soft-fail",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-client-boundaries.mjs",
    "lint:python": "cd backend && uv run ruff format --check . && uv run ruff check . && uv run pycodestyle --max-line-length=88 --ignore=E203,E501,W503,E704 app api tests",
    "lint:python:fix": "cd backend && uv run ruff format . && uv run ruff check --fix .",
    "typecheck:python": "cd backend && uv run pyright",
    "audit": "npm audit --audit-level=moderate",
    "generate:snapshot": "node scripts/generate-integration-catalog-snapshot.mjs",
    "check:snapshot": "npm run generate:snapshot && git diff --exit-code backend/app/integration_catalog_snapshot.json",
    "test:backend:python": "cd backend && uv run pytest tests -q"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@neondatabase/serverless": "^1.0.2",
    "@openhands/extensions": "github:OpenHands/extensions#c4d8d9727405d26fe9013f7ac4ca477cb61a37f6",
    "@tanstack/react-query": "^5.95.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "postcss": "^8.5.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.2",
    "@next/eslint-plugin-next": "^16.2.3",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "hono": "^4.12.25",
    "@hono/node-server": "^1.19.14",
    "postcss": "^8.5.10",
    "qs": ">=6.15.2",
    "brace-expansion": ">=5.0.6"
  }
}
