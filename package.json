{
  "name": "agent-integrations-hub",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:spa": "./scripts/build-spa.sh",
    "start": "next start",
    "db:migrate": "./scripts/run-migrations.sh",
    "db:migrate:check": "./scripts/run-migrations.sh --check",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:backend:python",
    "test:watch": "vitest",
    "test:mutation": "node ./scripts/run-mutation.mjs",
    "test:mutation:dry": "node ./scripts/run-mutation.mjs --dry-run",
    "test:mutation:all": "node ./scripts/run-mutation.mjs --all --soft-fail",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:python": "cd backend && uv run ruff format --check . && uv run ruff check . && uv run pycodestyle --max-line-length=88 --ignore=E203,E501,W503,E704 app tests",
    "lint:python:fix": "cd backend && uv run ruff format . && uv run ruff check --fix .",
    "typecheck:python": "cd backend && uv run pyright",
    "check:deprecations": "uv run --with packaging python .github/scripts/check_deprecations.py",
    "audit": "npm audit --audit-level=moderate",
    "test:backend:python": "cd backend && uv run pytest tests -q"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@openhands/extensions": "^0.10.0",
    "@tanstack/react-query": "^5.95.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.12",
    "posthog-js": "^1.372.6",
    "postcss": "^8.5.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "hono": "4.12.34",
    "@hono/node-server": "2.0.10",
    "postcss": "^8.5.23",
    "qs": ">=6.15.2",
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.2",
    "sharp": "0.35.0"
  }
}
