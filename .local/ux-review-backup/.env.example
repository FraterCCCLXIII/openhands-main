# OpenHands Cloud used for dashboard cookie validation
INTHUB_OPENHANDS_BASE_URL=https://staging.all-hands.dev
INTHUB_OPENHANDS_AUTH_COOKIE_NAME=keycloak_auth

# Kubernetes/Docker same-origin mount. The published container image is built
# for these prefixes; leave them unset for a root-mounted development build.
# INTHUB_ROOT_PATH=/integrations-hub
# INTHUB_API_ROOT_PATH=/api/integrations-hub
# NEXT_PUBLIC_INTHUB_UI_BASE_PATH=/integrations-hub
# NEXT_PUBLIC_INTHUB_API_BASE_PATH=/api/integrations-hub

# Externally visible Integrations Hub site URL. Required for OAuth callbacks;
# its path must match INTHUB_ROOT_PATH.
# INTHUB_PUBLIC_BASE_URL=https://example.com/integrations-hub

# Product analytics (disabled when unset)
# INTHUB_POSTHOG_CLIENT_KEY=phc_...

# Stored provider credential encryption
# Generate with: openssl rand -base64 32
INTHUB_CREDENTIAL_ENCRYPTION_KEY=change-me

# UX review mode — browse the dashboard with static fixture data (no Postgres/API required).
# NEXT_PUBLIC_UX_REVIEW_MODE=true

# Provider OAuth apps for built-in per-user connections
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=

# Provider OAuth preview deployments: set to the stable public origin
# used by third-party provider callback allowlists.
# INTHUB_OAUTH_REDIRECT_PROXY_URL=https://integrations-hub.example.com

# Database connection (the backend reads only the INTHUB_-prefixed URL).
# For production: use a managed Postgres connection string.
# For local development: use a standard Postgres connection string.
INTHUB_POSTGRES_URL=
COMPOSIO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
INTHUB_CRON_SECRET=change-me
INTHUB_APP_ADMIN_EMAILS=

# FastAPI backend config uses explicit INTHUB_* names. Leave optional settings
# commented out (or fully unset) unless you have a real value: blank
# `INTHUB_*=` entries are treated as "not configured" by the backend (see
# backend/app/config.py).
